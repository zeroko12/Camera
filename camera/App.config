<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <add key="AspectRatio" value="1.3333333333333333" />
        <add key="CanClickThrough" value="false" />
        <add key="Topmost" value="true" />
        <add key="WindowWidth" value="900" />
        <add key="WindowHeight" value="500" />
        <add key="WindowLeft" value="200" />
        <add key="WindowTop" value="150" />
        <add key="isSave" value="true" />
        <add key="Opacity" value="1.0" />
        <add key="Title" value="监控" />
        <add key="SystemTitle" value="监控" />
        <add key="OverwriteOldFiles" value="true" />
        <add key="DiskSpaceThreshold" value="10240" />
        <add key="Quality" value="20" />
        <add key="SaveInterval" value="1" />
        <!-- 硬件编码器并发会话限制（可选运维覆盖项）
             ★ MaxQsvSessions=0 表示【自动检测】（推荐），程序会根据 CPU 型号自动推断：
               - Intel N100/N95/N200、12代+         → 8
               - Intel 11代 Tiger Lake (1165G7等)   → 8
               - Intel 8-10代 UHD (8750H/10510U等) → 6
               - Intel 6-7代 HD (6700K/7400等)      → 4
               - AMD Ryzen / 非Intel                → 0 (不使用QSV)
             ★ 设为正数（如 MaxQsvSessions=12）可强制覆盖自动检测值
             NVENC: 消费级显卡=2, 专业卡可调高至8-32
             AMF: 3-4 -->
        <add key="MaxNvencSessions" value="2" />
        <add key="MaxAmfSessions" value="3" />
        <add key="MaxQsvSessions" value="0" />
        <add key="UseV3Architecture" value="true" />
        <add key="ForceCpuEncoding" value="false" />
    </appSettings>
</configuration>