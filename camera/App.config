<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <add key="AspectRatio" value="1.3333333333333333" />
        <add key="CanClickThrough" value="false" />
        <add key="Topmost" value="true" />
        <add key="WindowWidth" value="450" />
        <add key="WindowHeight" value="240" />
        <add key="WindowLeft" value="100" />
        <add key="WindowTop" value="100" />
        <add key="isSave" value="true" />
        <add key="Opacity" value="1.0" />
        <add key="Title" value="季华恒一离子注入器监控" />
        <add key="OverwriteOldFiles" value="true" />
        <add key="DiskSpaceThreshold" value="10240" />
        <add key="Quality" value="20" />
        <add key="SaveInterval" value="1" />
        <!-- 硬件编码器并发会话限制
             NVENC: 消费级显卡=2, 专业卡=8-32
             AMF: 3-4
             QSV: 2 -->
        <add key="MaxNvencSessions" value="2" />
        <add key="MaxAmfSessions" value="3" />
        <add key="MaxQsvSessions" value="2" />
        <add key="UseV3Architecture" value="true" />
    </appSettings>
</configuration>