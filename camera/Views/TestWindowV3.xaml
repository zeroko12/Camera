<Window x:Class="camera.Views.TestWindowV3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CameraServiceV3 测试"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="启动摄像头" Command="{Binding StartCommand}" Margin="5" Padding="10,5"/>
            <Button Content="停止摄像头" Command="{Binding StopCommand}" Margin="5" Padding="10,5"/>
            <Button Content="开始录制" Command="{Binding StartRecordingCommand}" Margin="5" Padding="10,5"/>
            <Button Content="停止录制" Command="{Binding StopRecordingCommand}" Margin="5" Padding="10,5"/>
            <Button Content="关闭窗口" Command="{Binding CloseCommand}" Margin="5" Padding="10,5"/>
        </StackPanel>

        <!-- 中间画面显示 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 摄像头画面 -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="2" Background="Black">
                <Image Source="{Binding CurrentFrame}" Stretch="Uniform"/>
            </Border>

            <!-- 状态信息 -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="状态信息" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                        <TextBlock Text="摄像头状态:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding CameraStatus}" TextWrapping="Wrap"/>

                        <TextBlock Text="录制状态:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding RecordingStatus}" TextWrapping="Wrap"/>

                        <TextBlock Text="当前录制文件:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding CurrentRecordingPath}" TextWrapping="Wrap"/>

                        <TextBlock Text="分辨率:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding Resolution}" TextWrapping="Wrap"/>

                        <TextBlock Text="帧率:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding Fps}" TextWrapping="Wrap"/>

                        <TextBlock Text="日志:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ListBox ItemsSource="{Binding Logs}" Height="200" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="2" Text="提示: 点击启动摄像头开始测试，画面会实时显示"
                   Margin="0,10,0,0" Foreground="Gray"/>
    </Grid>
</Window>
