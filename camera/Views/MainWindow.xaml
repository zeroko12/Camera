<Window
    x:Class="camera.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:hk="clr-namespace:FastHotKeyForWPF;assembly=FastHotKeyForWPF"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:infrastructure="clr-namespace:camera.Infrastructure"
    xmlns:local="clr-namespace:camera"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding SystemTitle}"
    Width="900"
    Height="480"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="{Binding LogoPath}"
    ResizeMode="CanResize"
    WindowStyle="None">
    <!--
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None">
    -->

    <!-- <Window.Style>
        <Style TargetType="Window" >
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="0"
                        CornerRadius="5"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>-->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <!-- 已删除 MatToImageSourceConverter 资源,见 ImageMatHelper.cs -->
        <Storyboard x:Key="FlashStoryboard" RepeatBehavior="Forever">
            <!--  瞬间切换到不透明  -->
            <DoubleAnimation
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0" />
            <!--  等待一段时间  -->
            <DoubleAnimation
                BeginTime="0:0:0.5"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0" />
            <!--  切回透明  -->
            <DoubleAnimation
                BeginTime="0:0:1.0"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0" />
            <!--  等待一段时间  -->
            <DoubleAnimation
                BeginTime="0:0:1.5"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0" />
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            MouseEnter="MainContentGrid_MouseEnter"
            MouseLeave="MainContentGrid_MouseLeave">
            <!-- <Image Source="{Binding Cam.Frame, Converter={StaticResource MatToImageSourceConverter}}" /> -->

            <Border
                x:Name="MainBorder"
                Margin="10,2,2,10"
                BorderThickness="1"
                Effect="{StaticResource EffectShadow3}"
                Opacity="{Binding Opacity}">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="5">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Cameras}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{c:Binding 'Math.Ceiling(Math.Sqrt(Cameras.Count))'}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <hc:ImageBlock
                                            Margin="0"
                                            local:ImageMatHelper.SourceMat="{Binding Frame}"
                                            AllowDrop="True"
                                            Cursor="Hand"
                                            DragOver="ImageBlock_DragOver"
                                            Drop="ImageBlock_Drop"
                                            MouseMove="ImageBlock_MouseMove"
                                            PreviewMouseLeftButtonDown="ImageBlock_PreviewMouseLeftButtonDown">
                                            <hc:ImageBlock.ContextMenu>
                                                <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem
                                                        Header="开启摄像头"
                                                        Command="{Binding EnableCameraCommand}"
                                                        IsEnabled="{Binding IsManualDisabled}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="PlayCircle" Foreground="#2ECC71" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Header="关闭摄像头"
                                                        Command="{Binding DisableCameraCommand}"
                                                        IsEnabled="{Binding IsConnected}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="StopCircle" Foreground="#E74C3C" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </hc:ImageBlock.ContextMenu>
                                            <hc:ImageBlock.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.ToggleMaximizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="LeftDoubleClick" />
                                            </hc:ImageBlock.InputBindings>
                                        </hc:ImageBlock>
                                        <!--  零 CPU 损耗 UI 水印叠加  -->
                                        <StackPanel
                                            Margin="15"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            IsHitTestVisible="False"
                                            Orientation="Vertical">
                                            <TextBlock
                                                FontSize="{c:Binding 'OverlayTextSize * 46.6'}"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding CustomOverlayText}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="3"
                                                        Direction="320"
                                                        ShadowDepth="1"
                                                        Color="Black" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="{c:Binding 'OverlayTextSize * 46.6'}"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding CurrentTimeText}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="3"
                                                        Direction="320"
                                                        ShadowDepth="1"
                                                        Color="Black" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  初始打开加载状态标识遮罩层  -->
                        <Border
                            Background="#DD1E1E1E"
                            CornerRadius="5"
                            Panel.ZIndex="99"
                            Visibility="{c:Binding IsInitializing,
                                                   FalseToVisibility=Collapsed}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <hc:LoadingCircle
                                    Width="45"
                                    Height="45"
                                    Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock
                                    Margin="0,15,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding LoadingStatusText}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <TextBlock
                x:Name="Instructions"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontSize="10"
                Foreground="White"
                Visibility="Hidden">
                穿透模式
            </TextBlock>

            <!--<TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="8"
                Foreground="Red"
                Visibility="{Binding isSave, Converter={StaticResource Boolean2VisibilityConverter}}">
                录像中
            </TextBlock>-->
            <Ellipse
                x:Name="RecordEllipse"
                Width="8"
                Height="8"
                Margin="20,20,12,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="Red"
                ToolTip="录制中"
                Visibility="{Binding isSave, Converter={StaticResource Boolean2VisibilityConverter}}">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Window.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FlashStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!--  全屏高清视图覆盖层  -->
            <Grid
                x:Name="MaximizedView"
                Panel.ZIndex="100"
                Background="{DynamicResource BackgroundBrush}"
                ClipToBounds="True"
                Visibility="{c:Binding IsSingleCameraMode,
                                       FalseToVisibility=Collapsed}">

                <!--  放大画面填满整个网格区域  -->
                <hc:ImageBlock
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    DataContext="{Binding SelectedCamera}"
                    local:ImageMatHelper.SourceMat="{Binding Frame}">
                    <hc:ImageBlock.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem
                                Header="开启摄像头"
                                Command="{Binding EnableCameraCommand}"
                                IsEnabled="{Binding IsManualDisabled}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PlayCircle" Foreground="#2ECC71" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="关闭摄像头"
                                Command="{Binding DisableCameraCommand}"
                                IsEnabled="{Binding IsConnected}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="StopCircle" Foreground="#E74C3C" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </hc:ImageBlock.ContextMenu>
                    <hc:ImageBlock.InputBindings>
                        <MouseBinding Command="{Binding DataContext.BackToGridCommand, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}" MouseAction="LeftDoubleClick" />
                    </hc:ImageBlock.InputBindings>
                </hc:ImageBlock>

                <!--  悬浮返回按钮，叠加在画面左上角  -->
                <Button
                    MinHeight="28"
                    Margin="10"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="101"
                    Command="{Binding BackToGridCommand}"
                    Content="返回网格"
                    Opacity="0.85"
                    Style="{StaticResource ButtonPrimary.Small}" />
            </Grid>

            <!--  全屏回放面板覆盖层  -->
            <Grid
                x:Name="PlaybackView"
                Panel.ZIndex="110"
                Background="{DynamicResource BackgroundBrush}"
                ClipToBounds="True"
                Visibility="{c:Binding IsPlaybackMode,
                                       FalseToVisibility=Collapsed}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左侧：日期与通道列表  -->
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  日期选择  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="选择回放日期" />
                        <Calendar
                            Grid.Row="1"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Center"
                            DisplayDateEnd="{x:Static System:DateTime.Today}"
                            SelectedDate="{Binding PlaybackSelectedDate, Mode=TwoWay}" />

                        <!--  通道选择  -->
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="选择监控通道" />
                        <ListBox
                            Grid.Row="3"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Cameras}"
                            SelectedItem="{Binding PlaybackSelectedCamera, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="Black" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding CustomOverlayText, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="Gray" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="#555555" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                        <Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold" Text="{Binding Name, StringFormat='通道: {0}'}" />
                                                <TextBlock Text="{Binding CustomOverlayText, StringFormat='自定义水印: {0}'}" />
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!--  右侧：播放画面与时间轴  -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <!--  视频播放区域  -->
                    <Border
                        Grid.Row="0"
                        Margin="5"
                        Background="Black"
                        ClipToBounds="True"
                        CornerRadius="4">
                        <MediaElement
                            x:Name="PlaybackPlayer"
                            LoadedBehavior="Manual"
                            MediaEnded="PlaybackPlayer_MediaEnded"
                            MediaOpened="PlaybackPlayer_MediaOpened"
                            UnloadedBehavior="Stop" />
                    </Border>

                    <!--  控制按钮栏  -->
                    <Border
                        Grid.Row="1"
                        Padding="10,5"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Click="Play_Click"
                                    Content="播放"
                                    IsEnabled="{c:Binding 'PlaybackState != &quot;Playing&quot;'}"
                                    Style="{StaticResource ButtonPrimary.Small}" />
                                <Button
                                    Margin="0,0,5,0"
                                    Click="Pause_Click"
                                    Content="暂停"
                                    IsEnabled="{c:Binding 'PlaybackState == &quot;Playing&quot;'}"
                                    Style="{StaticResource ButtonDefault.Small}" />
                                <Button
                                    Click="Stop_Click"
                                    Content="停止"
                                    IsEnabled="{c:Binding 'PlaybackState != &quot;Stopped&quot;'}"
                                    Style="{StaticResource ButtonDanger.Small}" />

                                <!--  播放状态文字展示  -->
                                <TextBlock
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="已停止" />
                                            <Setter Property="Foreground" Value="#7F8C8D" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlaybackState}" Value="Playing">
                                                    <Setter Property="Text" Value="播放中" />
                                                    <Setter Property="Foreground" Value="#27AE60" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackState}" Value="Paused">
                                                    <Setter Property="Text" Value="已暂停" />
                                                    <Setter Property="Foreground" Value="#E67E22" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackState}" Value="Stopped">
                                                    <Setter Property="Text" Value="已停止" />
                                                    <Setter Property="Foreground" Value="#7F8C8D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!--  倍速控制  -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="播放倍速:" />
                                <Button
                                    Height="24"
                                    MinWidth="24"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding SpeedDownCommand}"
                                    Content="-"
                                    IsEnabled="{c:Binding 'PlaybackSpeed > 0.5'}"
                                    Style="{StaticResource ButtonDefault.Small}"
                                    ToolTip="减速" />
                                <TextBlock
                                    Width="45"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding PlaybackSpeed, StringFormat='{}{0:F1}x'}"
                                    TextAlignment="Center" />
                                <Button
                                    Height="24"
                                    MinWidth="24"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding SpeedUpCommand}"
                                    Content="+"
                                    IsEnabled="{c:Binding 'PlaybackSpeed &lt; 32.0'}"
                                    Style="{StaticResource ButtonDefault.Small}"
                                    ToolTip="加速" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  24小时交互式 Canvas 时间轴  -->
                    <Grid Grid.Row="2" Background="#1E1E1E">
                        <Canvas
                            x:Name="TimelineCanvas"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                            MouseMove="TimelineCanvas_MouseMove"
                            MouseWheel="TimelineCanvas_MouseWheel" />
                    </Grid>
                </Grid>

                <!--  悬浮返回按钮，叠加在画面右上角  -->
                <Button
                    Grid.Column="1"
                    MinHeight="28"
                    Margin="10"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="111"
                    Command="{Binding BackToMonitoringCommand}"
                    Content="返回实时监控"
                    Opacity="0.85"
                    Style="{StaticResource ButtonPrimary.Small}" />
            </Grid>

            <!--<materialDesign:PackIcon
    Grid.Column="0"
    Margin="10"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Kind="GamepadCircleRight">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Clicked">
            <i:InvokeCommandAction Command="{Binding ShowConsole}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</materialDesign:PackIcon>-->
            <!--<Button
    Width="30"
    Margin="20"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    hc:IconElement.Geometry="{StaticResource LeftGeometry}"
    Command="{Binding ShowConsole}"
    IsEnabled="True"
    Style="{StaticResource ButtonDashedWarning}" />-->

            <ToggleButton
                x:Name="ConsoleToggleButton"
                Width="30"
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                hc:IconSwitchElement.Geometry="{StaticResource RightGeometry}"
                hc:IconSwitchElement.GeometrySelected="{StaticResource LeftGeometry}"
                Command="{Binding ShowConsole}"
                Style="{StaticResource ToggleButtonIcon}"
                Visibility="Collapsed" />

            <ResizeGrip
                x:Name="WindowResizeGrip"
                Margin="10,2,2,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                Opacity="0" />

            <!--  自定义标题栏  -->
            <Grid
                x:Name="TitleBar"
                Grid.Row="0"
                Height="30"
                Margin="10,0,0,10"
                VerticalAlignment="Top"
                Background="#90000000"
                MouseEnter="TitleBar_MouseEnter"
                MouseLeave="TitleBar_MouseLeave"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        Source="{Binding LogoPath}"
                        Visibility="{Binding LogoVisibility}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="{Binding SystemTitle}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <!--<Button
              Width="30"
              Height="30"
              Click="MinimizeButton_Click"
              Content="—" />
          <Button
              Width="30"
              Height="30"
              Click="MaximizeRestoreButton_Click"
              Content="□" />
          <Button
              Width="30"
              Height="30"
              Click="CloseButton_Click"
              Content="×" />-->

                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMinGeometry}"
                        hc:IconElement.Height="16"
                        hc:IconElement.Width="16"
                        Click="MinimizeButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedWarning.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMaxGeometry}"
                        Click="MaximizeRestoreButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedSuccess.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                        Click="CloseButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedDanger.Small}" />
                </StackPanel>
            </Grid>

        </Grid>


        <!--<WrapPanel Grid.Row="1">
            <TextBlock>宽:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Width}" />
            <TextBlock>高:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Height}" />
            <TextBlock>帧率</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Fps}" />
            <Button Command="{Binding Set}">应用</Button>
            <TextBlock VerticalAlignment="Center">是否保存:</TextBlock>
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding isSave}" />
        </WrapPanel>-->

        <hc:TransitioningContentControl
            x:Name="MyTransitioningContentControl"
            Grid.RowSpan="2"
            Grid.Column="1"
            TransitionMode="Left2RightWithFade"
            Visibility="{c:Binding ConsoleStatus,
                                   FalseToVisibility=Hidden}">
            <Border Margin="10" Effect="{StaticResource EffectShadow3}">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="5">

                    <Grid Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Expander
                                    Width="125"
                                    Margin="2"
                                    ExpandDirection="Down"
                                    Header="录像相关"
                                    IsExpanded="False">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel>
                                            <hc:ButtonGroup Margin="5">
                                                <RadioButton Content="录像关" IsChecked="{c:Binding !isSave}" />
                                                <RadioButton Content="录像开" IsChecked="{c:Binding isSave}" />
                                            </hc:ButtonGroup>
                                            <UniformGrid Columns="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="Black">
                                                    压缩程度
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Name="NumericUpDownCustomVerify"
                                                    Margin="5"
                                                    infrastructure:InputBehavior.UpdateOnEnter="True"
                                                    Maximum="51"
                                                    Minimum="0"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="当前值越大,保存文件越小"
                                                    Value="{Binding Quality}" />

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    保存间隔
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Margin="5"
                                                    infrastructure:InputBehavior.UpdateOnEnter="True"
                                                    Maximum="99"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="分钟"
                                                    Value="{Binding SaveInterval}" />
                                            </UniformGrid>
                                            <Separator />
                                            <Button
                                                Margin="5"
                                                Command="{Binding ViewPlayback}"
                                                Content="查看回放" />
                                            <Button
                                                Margin="5"
                                                Command="{Binding OpenRecordingFolderCommand}"
                                                Content="打开录像文件夹" />

                                            <!--<hc:Divider HorizontalContentAlignment="Left" Content="空间策略" />-->
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                空间策略
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" ToolTip="当前磁盘空间少于此MB数时">
                                                <TextBlock
                                                    Margin="2,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    少于
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Width="78"
                                                    Margin="2"
                                                    infrastructure:InputBehavior.UpdateOnEnter="True"
                                                    infrastructure:InputBehavior.EnterCommand="{Binding ConfirmDiskThresholdCommand}"
                                                    Maximum="1024000"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    Value="{Binding DiskSpaceThresholdInput}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    M
                                                </TextBlock>
                                            </StackPanel>
                                            <Button
                                                Margin="2"
                                                Command="{Binding ConfirmDiskThresholdCommand}"
                                                Content="确定"
                                                Style="{StaticResource ButtonPrimary.Small}" />
                                            <TextBlock
                                                Margin="2,2,2,4"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{Binding DiskSpaceThresholdStatusColor}"
                                                Text="{Binding DiskSpaceThresholdStatusText}"
                                                TextWrapping="Wrap" />
                                            <Separator />
                                            <hc:ButtonGroup Margin="4" Orientation="Vertical">
                                                <RadioButton Content="覆盖旧文件" IsChecked="{c:Binding OverwriteOldFiles}" />
                                                <RadioButton Content="停止录像" IsChecked="{c:Binding !OverwriteOldFiles}" />
                                            </hc:ButtonGroup>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Expander
                                    Width="125"
                                    Margin="2"
                                    ExpandDirection="Down"
                                    Header="其他设置"
                                    IsExpanded="False">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel>
                                            <UniformGrid Columns="2">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">是否置顶</TextBlock>
                                                <ToggleButton
                                                    x:Name="topMostButton"
                                                    HorizontalAlignment="Center"
                                                    Click="ToggleButton_Click"
                                                    IsChecked="True"
                                                    ToolTip="窗口置顶">
                                                    <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                                        <materialDesign:PackIcon.RenderTransform>
                                                            <RotateTransform Angle="45" />
                                                        </materialDesign:PackIcon.RenderTransform>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:ToggleButtonAssist.OnContent>
                                                        <materialDesign:PackIcon Kind="Pin" />
                                                    </materialDesign:ToggleButtonAssist.OnContent>
                                                    <ToggleButton.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.MergedDictionaries>
                                                                <materialDesign:BundledTheme
                                                                    BaseTheme="Light"
                                                                    PrimaryColor="BlueGrey"
                                                                    SecondaryColor="Lime" />
                                                                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                                            </ResourceDictionary.MergedDictionaries>
                                                        </ResourceDictionary>
                                                    </ToggleButton.Resources>
                                                </ToggleButton>
                                            </UniformGrid>
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                透明度调节
                                            </TextBlock>
                                            <Slider
                                                x:Name="OpacitySlider"
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="1.0"
                                                Minimum="0.1"
                                                TickFrequency="0.1"
                                                ToolTip="窗口几乎透明--窗口不透明"
                                                Value="{Binding Opacity}" />
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                预览帧率
                                            </TextBlock>
                                            <Slider
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="{Binding MaxFps}"
                                                Minimum="1"
                                                TickFrequency="1"
                                                ToolTip="预览帧率，越低越省CPU"
                                                Value="{Binding PreviewFps}" />
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                ToolTip="仅影响UI预览画面的显示分辨率，不影响录像质量。降低可减少CPU占用。">
                                                预览显示分辨率
                                            </TextBlock>
                                            <ComboBox
                                                Margin="5"
                                                ItemsSource="{Binding PreviewWidthOptions}"
                                                SelectedItem="{Binding SelectedPreviewWidth, Mode=TwoWay}"
                                                Style="{StaticResource ComboBoxExtend}"
                                                ToolTip="UI预览画面的显示分辨率，不影响录像分辨率" />
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                穿透模式快捷键
                                            </TextBlock>
                                            <hk:HotKeyBox
                                                Width="120"
                                                Height="14"
                                                Margin="0,4,0,4"
                                                ActualBackground="LightGray"
                                                CurrentKeyA="0x0002"
                                                CurrentKeyB="F1"
                                                FontSize="8"
                                                Handler="GlobalDo"
                                                HoverBorderBrush="#326cf3"
                                                HoverTextColor="#326cf3"
                                                ToolTip="穿透模式快捷键" />
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                亮度调节
                                            </TextBlock>
                                            <Slider
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="100.0"
                                                Minimum="-100.0"
                                                TickFrequency="0.1"
                                                ToolTip="亮度暗--亮"
                                                Value="{Binding Luminance}" />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                对比度调节
                                            </TextBlock>
                                            <Slider
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="4"
                                                Minimum="0"
                                                TickFrequency="0.1"
                                                ToolTip="对比度低--高"
                                                Value="{Binding Contrast}" />
                                            <Button
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                Command="{Binding ResetImageSettings}"
                                                Content="恢复默认"
                                                FontSize="10"
                                                Style="{StaticResource ButtonDashedWarning.Small}"
                                                ToolTip="重置亮度为0、对比度为1.0" />
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                水印大小调节
                                            </TextBlock>
                                            <Slider
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="2.0"
                                                Minimum="0.3"
                                                TickFrequency="0.1"
                                                ToolTip="全局水印和时间戳大小比例"
                                                Value="{Binding OverlayTextSize, Mode=TwoWay}" />

                                            <Separator />
                                            <UniformGrid Columns="2">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">夜间处理</TextBlock>
                                                <ToggleButton
                                                    HorizontalAlignment="Center"
                                                    IsChecked="{Binding IsGrayHomogenization}"
                                                    ToolTip="是否开启自适应直方图均衡化">
                                                    <materialDesign:PackIcon Kind="WhiteBalanceSunny" RenderTransformOrigin=".5,.5">
                                                        <materialDesign:PackIcon.RenderTransform>
                                                            <RotateTransform Angle="45" />
                                                        </materialDesign:PackIcon.RenderTransform>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:ToggleButtonAssist.OnContent>
                                                        <materialDesign:PackIcon Kind="WeatherNight" />
                                                    </materialDesign:ToggleButtonAssist.OnContent>
                                                    <ToggleButton.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.MergedDictionaries>
                                                                <materialDesign:BundledTheme
                                                                    BaseTheme="Light"
                                                                    PrimaryColor="BlueGrey"
                                                                    SecondaryColor="Lime" />
                                                                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                                            </ResourceDictionary.MergedDictionaries>
                                                        </ResourceDictionary>
                                                    </ToggleButton.Resources>
                                                </ToggleButton>
                                            </UniformGrid>
                                        </StackPanel>

                                    </Border>
                                </Expander>

                                <Expander
                                    Width="125"
                                    Margin="2"
                                    ExpandDirection="Down"
                                    Header="通道配置"
                                    IsExpanded="True">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel Margin="5">
                                            <TextBlock
                                                Margin="0,2,0,2"
                                                FontSize="11"
                                                Text="选择通道:" />
                                            <ComboBox
                                                Margin="0,0,0,5"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding Cameras}"
                                                SelectedItem="{Binding SelectedConfigCamera, Mode=TwoWay}"
                                                Style="{StaticResource ComboBoxExtend}" />

                                            <ContentControl Content="{Binding SelectedConfigCamera}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <Separator Margin="0,2,0,5" />

                                                            <TextBlock
                                                                Margin="0,2,0,2"
                                                                FontSize="11"
                                                                Text="自定义水印:" />
                                                            <TextBox
                                                                Margin="0,0,0,5"
                                                                hc:InfoElement.Placeholder="输入水印文字(实时生效)"
                                                                infrastructure:InputBehavior.UpdateOnEnter="True"
                                                                Style="{StaticResource TextBoxExtend}"
                                                                Text="{Binding CustomOverlayText, UpdateSourceTrigger=PropertyChanged}" />

                                                            <Separator Margin="0,2,0,5" />

                                                            <StackPanel Margin="0,2,0,4" Orientation="Vertical">
                                                                <TextBlock FontSize="11" Foreground="Gray" Text="物理接口规格:" />
                                                                <TextBlock
                                                                    Margin="0,1,0,0"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                                    Text="{Binding UsbSpeedDescription}" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Margin="0,2,0,2"
                                                                FontSize="11"
                                                                Text="采集分辨率:"
                                                                ToolTip="摄像头实际采集的分辨率，影响录像质量" />
                                                            <ComboBox
                                                                Margin="0,0,0,3"
                                                                ItemsSource="{Binding SupportedResolutions}"
                                                                SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                                                Style="{StaticResource ComboBoxExtend}" />

                                                            <StackPanel Margin="0,2,0,5" Orientation="Vertical">
                                                                <TextBlock FontSize="10" Foreground="Gray" Text="估算传输数据流:" />
                                                                <TextBlock
                                                                    Margin="0,1,0,0"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="DarkOrange"
                                                                    Text="{Binding EstimatedMbPerSec, StringFormat={}{0:F1} MB/s}" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Margin="0,2,0,2"
                                                                FontSize="11"
                                                                Text="录制分辨率:"
                                                                ToolTip="保存的视频文件分辨率，低于采集分辨率时会自动缩放以节省空间" />
                                                            <ComboBox
                                                                Margin="0,0,0,3"
                                                                ItemsSource="{Binding SupportedRecordResolutions}"
                                                                SelectedItem="{Binding SelectedRecordResolution, Mode=TwoWay}"
                                                                Style="{StaticResource ComboBoxExtend}" />

                                                            <Separator Margin="0,2,0,5" />

                                                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                                <TextBlock FontSize="11" Text="录制帧率:" />
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                                    Text="{Binding RecordFps}" />
                                                            </StackPanel>
                                                            <Slider
                                                                IsSnapToTickEnabled="True"
                                                                Maximum="{Binding Fps}"
                                                                Minimum="1"
                                                                TickFrequency="1"
                                                                ToolTip="录制帧率，越低越省CPU和存储空间"
                                                                Value="{Binding RecordFps, Mode=TwoWay}" />

                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="Gray"
                                                                Text="当前采集:" />
                                                            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text="{Binding Width}" />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text=" x " />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text="{Binding Height}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>

                                            <!--  编码器状态指示  -->
                                            <Separator Margin="0,2,0,5" />
                                            <TextBlock
                                                Margin="0,2,0,2"
                                                FontSize="11"
                                                Text="编码加速状态:" />
                                            <Border
                                                Margin="0,2,0,2"
                                                Padding="5"
                                                Background="#E8F5E9"
                                                BorderBrush="#81C784"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{c:Binding IsGpuEncodingActive,
                                                                       FalseToVisibility=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#4CAF50" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#2E7D32"
                                                        Text="GPU 硬件加速" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Margin="0,2,0,2"
                                                Padding="5"
                                                Background="#FFFDE7"
                                                BorderBrush="#FFF176"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{c:Binding IsCpuEncodingActive,
                                                                       FalseToVisibility=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#FBC02D" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#F57F17"
                                                        Text="CPU 软件编码" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Margin="0,2,0,2"
                                                Padding="5"
                                                Background="#ECEFF1"
                                                BorderBrush="#B0BEC5"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{c:Binding IsEncodingInactive,
                                                                       FalseToVisibility=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#78909C" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#37474F"
                                                        Text="未开启录制" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Expander
                                    Width="125"
                                    Margin="2"
                                    ExpandDirection="Down"
                                    Header="系统状态"
                                    IsExpanded="True">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel Margin="5">
                                            <TextBlock
                                                Margin="0,2,0,2"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Text="空间预计录制" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="DarkRed"
                                                Text="{Binding DiskSpaceWarningText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>








                        </ScrollViewer>

                    </Grid>

                    <!--<TabControl TabStripPlacement="Left">
                        <TabControl.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <materialDesign:BundledTheme
                                        BaseTheme="Light"
                                        PrimaryColor="DeepPurple"
                                        SecondaryColor="Lime" />
                                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </TabControl.Resources>
                        <TabItem Header="TAB 1">
                            <TextBlock Margin="8" Text="Left placement" />
                        </TabItem>
                        <TabItem Header="TAB 2">
                            <TextBlock Margin="8" Text="Left placement" />
                        </TabItem>
                    </TabControl>-->
                </Border>
            </Border>
        </hc:TransitioningContentControl>
    </Grid>
</Window>
