<Window
    x:Class="camera.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:local="clr-namespace:camera"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="525"
    Height="350"
    prism:ViewModelLocator.AutoWireViewModel="True"
    SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <local:MatToImageSourceConverter x:Key="MatToImageSourceConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- <Image Source="{Binding Cam.Frame, Converter={StaticResource MatToImageSourceConverter}}" /> -->
        <ItemsControl ItemsSource="{Binding Cameras}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{c:Binding 'Math.Ceiling(Math.Sqrt(Cameras.Count))'}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Margin="5" Source="{Binding Frame, Converter={StaticResource MatToImageSourceConverter}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Grid.Row="1">
            <TextBlock>宽:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Width}" />
            <TextBlock>高:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Height}" />
            <TextBlock>帧率</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Fps}" />
            <Button Command="{Binding Set}">应用</Button>
            <TextBlock VerticalAlignment="Center">是否保存:</TextBlock>
            <RadioButton VerticalAlignment="Center" IsChecked="{Binding isSave}" />
        </WrapPanel>
    </Grid>
</Window>
