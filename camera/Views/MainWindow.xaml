<Window
    x:Class="camera.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:camera"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="900"
    Height="480"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStyle="None">
    <!--
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None">
    -->

    <!-- <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="0"
                        CornerRadius="5"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>-->
    <Window.Resources>
        <local:MatToImageSourceConverter x:Key="MatToImageSourceConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            MouseEnter="MainContentGrid_MouseEnter"
            MouseLeave="MainContentGrid_MouseLeave">
            <!-- <Image Source="{Binding Cam.Frame, Converter={StaticResource MatToImageSourceConverter}}" /> -->

            <Border
                x:Name="MainBorder"
                Margin="10,2,2,10"
                BorderThickness="1"
                Effect="{StaticResource EffectShadow3}">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="5">
                    <ItemsControl ItemsSource="{Binding Cameras}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{c:Binding 'Math.Ceiling(Math.Sqrt(Cameras.Count))'}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <hc:ImageBlock Margin="5" Source="{Binding Frame, Converter={StaticResource MatToImageSourceConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Border>

            <!--<materialDesign:PackIcon
    Grid.Column="0"
    Margin="10"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Kind="GamepadCircleRight">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Clicked">
            <i:InvokeCommandAction Command="{Binding ShowConsole}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</materialDesign:PackIcon>-->
            <!--<Button
    Width="30"
    Margin="20"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    hc:IconElement.Geometry="{StaticResource LeftGeometry}"
    Command="{Binding ShowConsole}"
    IsEnabled="True"
    Style="{StaticResource ButtonDashedWarning}" />-->

            <ToggleButton
                x:Name="ConsoleToggleButton"
                Width="30"
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                hc:IconSwitchElement.Geometry="{StaticResource RightGeometry}"
                hc:IconSwitchElement.GeometrySelected="{StaticResource LeftGeometry}"
                Command="{Binding ShowConsole}"
                Style="{StaticResource ToggleButtonIcon}"
                Visibility="Collapsed" />

            <ResizeGrip
                x:Name="WindowResizeGrip"
                Margin="10,2,2,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                Opacity="0" />

            <!--  自定义标题栏  -->
            <Grid
                x:Name="TitleBar"
                Grid.Row="0"
                Height="30"
                Margin="10,0,0,10"
                VerticalAlignment="Top"
                Background="#90000000"
                MouseEnter="TitleBar_MouseEnter"
                MouseLeave="TitleBar_MouseLeave"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="监控摄像头" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <!--<Button
              Width="30"
              Height="30"
              Click="MinimizeButton_Click"
              Content="—" />
          <Button
              Width="30"
              Height="30"
              Click="MaximizeRestoreButton_Click"
              Content="□" />
          <Button
              Width="30"
              Height="30"
              Click="CloseButton_Click"
              Content="×" />-->

                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMinGeometry}"
                        hc:IconElement.Height="16"
                        hc:IconElement.Width="16"
                        Click="MinimizeButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedWarning.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMaxGeometry}"
                        Click="MaximizeRestoreButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedSuccess.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                        Click="CloseButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedDanger.Small}" />
                </StackPanel>
            </Grid>

        </Grid>


        <!--<WrapPanel Grid.Row="1">
            <TextBlock>宽:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Width}" />
            <TextBlock>高:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Height}" />
            <TextBlock>帧率</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Fps}" />
            <Button Command="{Binding Set}">应用</Button>
            <TextBlock VerticalAlignment="Center">是否保存:</TextBlock>
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding isSave}" />
        </WrapPanel>-->

        <hc:TransitioningContentControl
            x:Name="MyTransitioningContentControl"
            Grid.RowSpan="2"
            Grid.Column="1"
            TransitionMode="Left2RightWithFade"
            Visibility="{c:Binding ConsoleStatus,
                                   FalseToVisibility=Hidden}">
            <Border Margin="10" Effect="{StaticResource EffectShadow3}">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="5">
                    <StackPanel Margin="5">
                        <ScrollViewer>
                            <StackPanel>
                                <Expander
                                    Width="125"
                                    Margin="2"
                                    ExpandDirection="Down"
                                    Header="录像相关"
                                    IsExpanded="True">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel>
                                            <hc:ButtonGroup Margin="5">
                                                <RadioButton
                                                    Command="{Binding SetSave}"
                                                    CommandParameter="False"
                                                    Content="录像关"
                                                    IsChecked="True" />
                                                <RadioButton
                                                    Command="{Binding SetSave}"
                                                    CommandParameter="True"
                                                    Content="录像开" />
                                            </hc:ButtonGroup>
                                            <UniformGrid Columns="                                                         2">
                                                <!--<TextBlock
                                                    HorizontalAlignment="
                                                        Center"
                                                    VerticalAlignment="
                                                        Center"
                                                    Foreground="
                                                        Black">
                                                    录像
                                                </TextBlock>
                                                -->
                                                <!--<CheckBox HorizontalAlignment="
                                                        Center" IsChecked="{Binding isSave}" />-->
                                                <!--
                                                <ToggleButton
                                                    HorizontalAlignment="left"
                                                    BorderThickness="0"
                                                    IsChecked="False"
                                                    IsEnabled="True"
                                                    Style="{StaticResource ToggleButtonFlip}"
                                                    ToolTip="录像功能">
                                                    <hc:StatusSwitchElement.CheckedElement>
                                                        <Border Background="{DynamicResource SuccessBrush}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextIconBrush}"
                                                                Text="开" />
                                                        </Border>
                                                    </hc:StatusSwitchElement.CheckedElement>
                                                    <Border Background="gray">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextIconBrush}"
                                                            Text="关" />
                                                    </Border>
                                                -->
                                                <!--<hc:Poptip.Instance>
        <hc:Poptip Content="录像功能" PlacementType="Bottom" />
    </hc:Poptip.Instance>-->
                                                <!--
                                                </ToggleButton>-->
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="Black">
                                                    压缩程度
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Name="NumericUpDownCustomVerify"
                                                    Margin="5"
                                                    Maximum="51"
                                                    Minimum="0"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="当前值越大,保存文件越小"
                                                    Value="{Binding Quality}" />

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    保存间隔
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Margin="5"
                                                    Maximum="99"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="分钟"
                                                    Value="{Binding SaveInterval}" />
                                                <!--<hc:TimePicker Style="{StaticResource TimePickerPlus.Small}">
                                                    <hc:TimePicker.Clock>
                                                        <hc:ListClock />
                                                    </hc:TimePicker.Clock>
                                                </hc:TimePicker>-->
                                            </UniformGrid>
                                            <Button Margin="5" Content="查看回放" />
                                            <hc:Divider Margin="0" Content="空间策略" />
                                            <StackPanel Orientation="Horizontal" ToolTip="当前磁盘空间少于此MB数时">
                                                <TextBlock
                                                    Margin="2,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    少于
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Width="78"
                                                    Margin="2"
                                                    Maximum="10240"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    Value="{Binding DiskSpaceThreshold}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    M
                                                </TextBlock>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <RadioButton
                                                    Margin="4"
                                                    Command="{Binding SetSaveMode}"
                                                    IsChecked="True" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black"
                                                    Text="覆盖旧文件" />
                                                <RadioButton
                                                    Grid.Row="1"
                                                    Margin="4"
                                                    Command="{Binding SetSaveMode}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black"
                                                    Text="停止录像   " />
                                            </Grid>

                                            <!--<TextBlock Foreground="Black">保存质量:</TextBlock>-->


                                        </StackPanel>

                                    </Border>
                                </Expander>
                            </StackPanel>








                        </ScrollViewer>

                    </StackPanel>
                    <!--<TabControl TabStripPlacement="Left">
                        <TabControl.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <materialDesign:BundledTheme
                                        BaseTheme="Light"
                                        PrimaryColor="DeepPurple"
                                        SecondaryColor="Lime" />
                                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </TabControl.Resources>
                        <TabItem Header="TAB 1">
                            <TextBlock Margin="8" Text="Left placement" />
                        </TabItem>
                        <TabItem Header="TAB 2">
                            <TextBlock Margin="8" Text="Left placement" />
                        </TabItem>
                    </TabControl>-->
                </Border>
            </Border>
        </hc:TransitioningContentControl>
    </Grid>
</Window>
