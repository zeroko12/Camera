<Window
    x:Class="camera.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:hk="clr-namespace:FastHotKeyForWPF;assembly=FastHotKeyForWPF"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:infrastructure="clr-namespace:camera.Infrastructure"
    xmlns:local="clr-namespace:camera"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding SystemTitle}"
    Width="900"
    Height="480"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="{Binding LogoPath}"
    ResizeMode="CanResize"
    WindowStyle="None">
    <!--
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None">
    -->

    <!-- <Window.Style>
        <Style TargetType="Window" >
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="0"
                        CornerRadius="5"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>-->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <!-- 已删除 MatToImageSourceConverter 资源,见 ImageMatHelper.cs -->
        <Storyboard x:Key="FlashStoryboard" RepeatBehavior="Forever">
            <!--  瞬间切换到不透明  -->
            <DoubleAnimation
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0" />
            <!--  等待一段时间  -->
            <DoubleAnimation
                BeginTime="0:0:0.5"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0" />
            <!--  切回透明  -->
            <DoubleAnimation
                BeginTime="0:0:1.0"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0" />
            <!--  等待一段时间  -->
            <DoubleAnimation
                BeginTime="0:0:1.5"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0" />
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            MouseEnter="MainContentGrid_MouseEnter"
            MouseLeave="MainContentGrid_MouseLeave">
            <!-- <Image Source="{Binding Cam.Frame, Converter={StaticResource MatToImageSourceConverter}}" /> -->

            <Border
                x:Name="MainBorder"
                Margin="10,2,2,10"
                BorderThickness="1"
                Effect="{StaticResource EffectShadow3}"
                Opacity="{Binding Opacity}">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="5">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Cameras}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{c:Binding 'Math.Ceiling(Math.Sqrt(Cameras.Count))'}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5" ClipToBounds="True">
                                        <Border Background="#161616" CornerRadius="4" />
                                        <Image
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="{Binding VideoStretch, Mode=OneWay, FallbackValue=Uniform}"
                                            local:ImageMatHelper.SourceMat="{Binding Frame}"
                                            AllowDrop="True"
                                            Cursor="Hand"
                                            DragOver="ImageBlock_DragOver"
                                            Drop="ImageBlock_Drop"
                                            MouseMove="ImageBlock_MouseMove"
                                            PreviewMouseLeftButtonDown="ImageBlock_PreviewMouseLeftButtonDown">
                                            <Image.ContextMenu>
                                                <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem
                                                        Header="开启摄像头"
                                                        Command="{Binding EnableCameraCommand}"
                                                        IsEnabled="{Binding IsManualDisabled}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="PlayCircle" Foreground="#2ECC71" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Header="关闭摄像头"
                                                        Command="{Binding DisableCameraCommand}"
                                                        IsEnabled="{Binding IsConnected}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="StopCircle" Foreground="#E74C3C" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem
                                                        Header="水平翻转"
                                                        IsCheckable="True"
                                                        IsChecked="{Binding IsFlipHorizontal, Mode=TwoWay}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="FlipHorizontal" Foreground="#3498DB" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Header="垂直翻转"
                                                        IsCheckable="True"
                                                        IsChecked="{Binding IsFlipVertical, Mode=TwoWay}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="FlipVertical" Foreground="#3498DB" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="画面比例">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="AspectRatio" Foreground="#3498DB" />
                                                        </MenuItem.Icon>
                                                        <MenuItem
                                                            Header="等比适应 (不变形)"
                                                            IsCheckable="True"
                                                            IsChecked="{Binding IsStretchUniform, Mode=OneWay}"
                                                            Command="{Binding SetStretchCommand}"
                                                            CommandParameter="Uniform">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="FitToPageOutline" Foreground="#2ECC71" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem
                                                            Header="等比裁剪 (填满不变形)"
                                                            IsCheckable="True"
                                                            IsChecked="{Binding IsStretchUniformToFill, Mode=OneWay}"
                                                            Command="{Binding SetStretchCommand}"
                                                            CommandParameter="UniformToFill">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Crop" Foreground="#E67E22" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem
                                                            Header="拉伸铺满 (可能变形)"
                                                            IsCheckable="True"
                                                            IsChecked="{Binding IsStretchFill, Mode=OneWay}"
                                                            Command="{Binding SetStretchCommand}"
                                                            CommandParameter="Fill">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="ArrowExpandAll" Foreground="#E74C3C" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Image.ContextMenu>
                                            <Image.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.ToggleMaximizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    MouseAction="LeftDoubleClick" />
                                            </Image.InputBindings>
                                        </Image>
                                        <!--  零 CPU 损耗 UI 水印叠加  -->
                                        <StackPanel
                                            Margin="15"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            IsHitTestVisible="False"
                                            Orientation="Vertical">
                                            <TextBlock
                                                FontSize="{c:Binding 'OverlayTextSize * 46.6'}"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding CustomOverlayText}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="3"
                                                        Direction="320"
                                                        ShadowDepth="1"
                                                        Color="Black" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="{c:Binding 'OverlayTextSize * 46.6'}"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding CurrentTimeText}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="3"
                                                        Direction="320"
                                                        ShadowDepth="1"
                                                        Color="Black" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  初始打开加载状态标识遮罩层  -->
                        <Border
                            Background="#DD1E1E1E"
                            CornerRadius="5"
                            Panel.ZIndex="99"
                            Visibility="{c:Binding IsInitializing,
                                                   FalseToVisibility=Collapsed}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <hc:LoadingCircle
                                    Width="45"
                                    Height="45"
                                    Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock
                                    Margin="0,15,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding LoadingStatusText}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <TextBlock
                x:Name="Instructions"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontSize="10"
                Foreground="White"
                Visibility="Hidden">
                穿透模式
            </TextBlock>

            <!--<TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="8"
                Foreground="Red"
                Visibility="{Binding isSave, Converter={StaticResource Boolean2VisibilityConverter}}">
                录像中
            </TextBlock>-->
            <Ellipse
                x:Name="RecordEllipse"
                Width="8"
                Height="8"
                Margin="20,20,12,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="Red"
                ToolTip="录制中"
                Visibility="{Binding isSave, Converter={StaticResource Boolean2VisibilityConverter}}">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Window.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FlashStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!--  全屏高清视图覆盖层  -->
            <Grid
                x:Name="MaximizedView"
                Panel.ZIndex="100"
                Background="{DynamicResource BackgroundBrush}"
                ClipToBounds="True"
                Visibility="{c:Binding IsSingleCameraMode,
                                       FalseToVisibility=Collapsed}">

                <!--  放大画面填满整个网格区域  -->
                <Image
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="{Binding VideoStretch, Mode=OneWay, FallbackValue=Uniform}"
                    DataContext="{Binding SelectedCamera}"
                    local:ImageMatHelper.SourceMat="{Binding Frame}">
                    <Image.ContextMenu>
                        <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem
                                Header="开启摄像头"
                                Command="{Binding EnableCameraCommand}"
                                IsEnabled="{Binding IsManualDisabled}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PlayCircle" Foreground="#2ECC71" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="关闭摄像头"
                                Command="{Binding DisableCameraCommand}"
                                IsEnabled="{Binding IsConnected}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="StopCircle" Foreground="#E74C3C" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Header="水平翻转"
                                IsCheckable="True"
                                IsChecked="{Binding IsFlipHorizontal, Mode=TwoWay}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FlipHorizontal" Foreground="#3498DB" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="垂直翻转"
                                IsCheckable="True"
                                IsChecked="{Binding IsFlipVertical, Mode=TwoWay}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FlipVertical" Foreground="#3498DB" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="画面比例">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="AspectRatio" Foreground="#3498DB" />
                                </MenuItem.Icon>
                                <MenuItem
                                    Header="等比适应 (不变形)"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsStretchUniform, Mode=OneWay}"
                                    Command="{Binding SetStretchCommand}"
                                    CommandParameter="Uniform">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FitToPageOutline" Foreground="#2ECC71" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Header="等比裁剪 (填满不变形)"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsStretchUniformToFill, Mode=OneWay}"
                                    Command="{Binding SetStretchCommand}"
                                    CommandParameter="UniformToFill">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Crop" Foreground="#E67E22" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Header="拉伸铺满 (可能变形)"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsStretchFill, Mode=OneWay}"
                                    Command="{Binding SetStretchCommand}"
                                    CommandParameter="Fill">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="ArrowExpandAll" Foreground="#E74C3C" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </ContextMenu>
                    </Image.ContextMenu>
                    <Image.InputBindings>
                        <MouseBinding Command="{Binding DataContext.BackToGridCommand, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}" MouseAction="LeftDoubleClick" />
                    </Image.InputBindings>
                </Image>

                <!--  悬浮返回按钮，叠加在画面左上角  -->
                <Button
                    MinHeight="28"
                    Margin="10"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="101"
                    Command="{Binding BackToGridCommand}"
                    Content="返回网格"
                    Opacity="0.85"
                    Style="{StaticResource ButtonPrimary.Small}" />
            </Grid>

            <!--  全屏回放面板覆盖层  -->
            <Grid
                x:Name="PlaybackView"
                Panel.ZIndex="110"
                Background="{DynamicResource BackgroundBrush}"
                ClipToBounds="True"
                Visibility="{c:Binding IsPlaybackMode,
                                       FalseToVisibility=Collapsed}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左侧：日期与通道列表  -->
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  日期选择  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="选择回放日期" />
                        <Calendar
                            Grid.Row="1"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Center"
                            DisplayDateEnd="{x:Static System:DateTime.Today}"
                            SelectedDate="{Binding PlaybackSelectedDate, Mode=TwoWay}" />

                        <!--  通道选择  -->
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="选择监控通道" />
                        <ListBox
                            Grid.Row="3"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Cameras}"
                            SelectedItem="{Binding PlaybackSelectedCamera, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="Black" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding CustomOverlayText, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="Gray" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="#555555" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                        <Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold" Text="{Binding Name, StringFormat='通道: {0}'}" />
                                                <TextBlock Text="{Binding CustomOverlayText, StringFormat='自定义水印: {0}'}" />
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!--  右侧：播放画面与时间轴  -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <!--  视频播放区域  -->
                    <Border
                        Grid.Row="0"
                        Margin="5"
                        Background="Black"
                        ClipToBounds="True"
                        CornerRadius="4">
                        <MediaElement
                            x:Name="PlaybackPlayer"
                            LoadedBehavior="Manual"
                            MediaEnded="PlaybackPlayer_MediaEnded"
                            MediaOpened="PlaybackPlayer_MediaOpened"
                            UnloadedBehavior="Stop" />
                    </Border>

                    <!--  控制按钮栏  -->
                    <Border
                        Grid.Row="1"
                        Padding="10,5"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Click="Play_Click"
                                    Content="播放"
                                    IsEnabled="{c:Binding 'PlaybackState != &quot;Playing&quot;'}"
                                    Style="{StaticResource ButtonPrimary.Small}" />
                                <Button
                                    Margin="0,0,5,0"
                                    Click="Pause_Click"
                                    Content="暂停"
                                    IsEnabled="{c:Binding 'PlaybackState == &quot;Playing&quot;'}"
                                    Style="{StaticResource ButtonDefault.Small}" />
                                <Button
                                    Click="Stop_Click"
                                    Content="停止"
                                    IsEnabled="{c:Binding 'PlaybackState != &quot;Stopped&quot;'}"
                                    Style="{StaticResource ButtonDanger.Small}" />

                                <!--  播放状态文字展示  -->
                                <TextBlock
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="已停止" />
                                            <Setter Property="Foreground" Value="#7F8C8D" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlaybackState}" Value="Playing">
                                                    <Setter Property="Text" Value="播放中" />
                                                    <Setter Property="Foreground" Value="#27AE60" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackState}" Value="Paused">
                                                    <Setter Property="Text" Value="已暂停" />
                                                    <Setter Property="Foreground" Value="#E67E22" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlaybackState}" Value="Stopped">
                                                    <Setter Property="Text" Value="已停止" />
                                                    <Setter Property="Foreground" Value="#7F8C8D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!--  倍速控制  -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="播放倍速:" />
                                <Button
                                    Height="24"
                                    MinWidth="24"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding SpeedDownCommand}"
                                    Content="-"
                                    IsEnabled="{c:Binding 'PlaybackSpeed > 0.5'}"
                                    Style="{StaticResource ButtonDefault.Small}"
                                    ToolTip="减速" />
                                <TextBlock
                                    Width="45"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding PlaybackSpeed, StringFormat='{}{0:F1}x'}"
                                    TextAlignment="Center" />
                                <Button
                                    Height="24"
                                    MinWidth="24"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding SpeedUpCommand}"
                                    Content="+"
                                    IsEnabled="{c:Binding 'PlaybackSpeed &lt; 32.0'}"
                                    Style="{StaticResource ButtonDefault.Small}"
                                    ToolTip="加速" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  24小时交互式 Canvas 时间轴  -->
                    <Grid Grid.Row="2" Background="#1E1E1E">
                        <Canvas
                            x:Name="TimelineCanvas"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                            MouseMove="TimelineCanvas_MouseMove"
                            MouseWheel="TimelineCanvas_MouseWheel" />
                    </Grid>
                </Grid>

                <!--  悬浮返回按钮，叠加在画面右上角  -->
                <Button
                    Grid.Column="1"
                    MinHeight="28"
                    Margin="10"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="111"
                    Command="{Binding BackToMonitoringCommand}"
                    Content="返回实时监控"
                    Opacity="0.85"
                    Style="{StaticResource ButtonPrimary.Small}" />
            </Grid>

            <!--<materialDesign:PackIcon
    Grid.Column="0"
    Margin="10"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Kind="GamepadCircleRight">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Clicked">
            <i:InvokeCommandAction Command="{Binding ShowConsole}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</materialDesign:PackIcon>-->
            <!--<Button
    Width="30"
    Margin="20"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    hc:IconElement.Geometry="{StaticResource LeftGeometry}"
    Command="{Binding ShowConsole}"
    IsEnabled="True"
    Style="{StaticResource ButtonDashedWarning}" />-->

            <ToggleButton
                x:Name="ConsoleToggleButton"
                Width="32"
                Height="32"
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Panel.ZIndex="1005"
                hc:IconSwitchElement.Geometry="{StaticResource RightGeometry}"
                hc:IconSwitchElement.GeometrySelected="{StaticResource LeftGeometry}"
                IsChecked="{Binding ConsoleStatus, Mode=TwoWay}"
                Style="{StaticResource ToggleButtonIcon}"
                Opacity="0.6"
                ToolTip="展开/收起控制面板" />

            <ResizeGrip
                x:Name="WindowResizeGrip"
                Margin="10,2,2,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                Opacity="0.4" />

            <!--  自定义标题栏  -->
            <Grid
                x:Name="TitleBar"
                Grid.Row="0"
                Height="30"
                Margin="10,0,0,10"
                VerticalAlignment="Top"
                Background="#90000000"
                MouseEnter="TitleBar_MouseEnter"
                MouseLeave="TitleBar_MouseLeave"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        Source="{Binding LogoPath}"
                        Visibility="{Binding LogoVisibility}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="{Binding SystemTitle}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <!--<Button
              Width="30"
              Height="30"
              Click="MinimizeButton_Click"
              Content="—" />
          <Button
              Width="30"
              Height="30"
              Click="MaximizeRestoreButton_Click"
              Content="□" />
          <Button
              Width="30"
              Height="30"
              Click="CloseButton_Click"
              Content="×" />-->

                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMinGeometry}"
                        hc:IconElement.Height="16"
                        hc:IconElement.Width="16"
                        Click="MinimizeButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedWarning.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMaxGeometry}"
                        Click="MaximizeRestoreButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedSuccess.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                        Click="CloseButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedDanger.Small}" />
                </StackPanel>
            </Grid>

        </Grid>


        <!--<WrapPanel Grid.Row="1">
            <TextBlock>宽:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Width}" />
            <TextBlock>高:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Height}" />
            <TextBlock>帧率</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Fps}" />
            <Button Command="{Binding Set}">应用</Button>
            <TextBlock VerticalAlignment="Center">是否保存:</TextBlock>
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding isSave}" />
        </WrapPanel>-->

        <hc:TransitioningContentControl
            x:Name="MyTransitioningContentControl"
            Grid.RowSpan="2"
            Grid.Column="1"
            Panel.ZIndex="1005"
            TransitionMode="Left2RightWithFade"
            Visibility="{c:Binding ConsoleStatus,
                                   FalseToVisibility=Hidden}">
            <Border Margin="10" Effect="{StaticResource EffectShadow3}">
                <Border
                    Width="180"
                    Background="{DynamicResource BackgroundBrush}"
                    CornerRadius="6">

                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  顶部面板标题栏与快速收起按钮  -->
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="控制面板"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="22"
                                Height="22"
                                Padding="0"
                                Command="{Binding ShowConsole}"
                                Style="{StaticResource ButtonDefault.Small}"
                                ToolTip="收起控制面板">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Kind="Close" />
                            </Button>
                        </Grid>

                        <!--  主控制列表滚动区  -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  1. 通道配置 (核心第一优先级，默认展开)  -->
                                <Expander
                                    Margin="0,0,0,4"
                                    ExpandDirection="Down"
                                    Header="通道配置"
                                    IsExpanded="True">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel Margin="6">
                                            <TextBlock
                                                Margin="0,0,0,3"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="选择通道:" />
                                            <ComboBox
                                                Margin="0,0,0,6"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding Cameras}"
                                                SelectedItem="{Binding SelectedConfigCamera, Mode=TwoWay}"
                                                Style="{StaticResource ComboBoxExtend}" />

                                            <ContentControl Content="{Binding SelectedConfigCamera}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <!--  通道在线状态与启停控制行  -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- 在线状态指示 -->
                                                                <StackPanel
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{c:Binding !IsManualDisabled,
                                                                                           FalseToVisibility=Collapsed}">
                                                                    <Ellipse
                                                                        Width="7"
                                                                        Height="7"
                                                                        Margin="0,0,5,0"
                                                                        VerticalAlignment="Center"
                                                                        Fill="#4CAF50" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="#2E7D32"
                                                                        Text="通道运行中"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <!-- 已停用指示 -->
                                                                <StackPanel
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{c:Binding IsManualDisabled,
                                                                                           FalseToVisibility=Collapsed}">
                                                                    <Ellipse
                                                                        Width="7"
                                                                        Height="7"
                                                                        Margin="0,0,5,0"
                                                                        VerticalAlignment="Center"
                                                                        Fill="#9E9E9E" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="Gray"
                                                                        Text="通道已停用"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <!-- 启停操作按钮 -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button
                                                                        Height="22"
                                                                        Padding="8,0"
                                                                        Command="{Binding EnableCameraCommand}"
                                                                        Content="开启"
                                                                        FontSize="11"
                                                                        Style="{StaticResource ButtonPrimary.Small}"
                                                                        ToolTip="重新开启此摄像头采集"
                                                                        Visibility="{c:Binding IsManualDisabled,
                                                                                               FalseToVisibility=Collapsed}" />
                                                                    <Button
                                                                        Height="22"
                                                                        Padding="8,0"
                                                                        Command="{Binding DisableCameraCommand}"
                                                                        Content="停用"
                                                                        FontSize="11"
                                                                        Style="{StaticResource ButtonDanger.Small}"
                                                                        ToolTip="临时停用此摄像头，释放系统资源"
                                                                        Visibility="{c:Binding !IsManualDisabled,
                                                                                               FalseToVisibility=Collapsed}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <Separator Margin="0,0,0,6" />

                                                            <!--  画面比例：纵向排布核心要求  -->
                                                            <TextBlock
                                                                Margin="0,0,0,3"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Text="画面比例:" />
                                                            <hc:ButtonGroup Margin="0,0,0,6" Orientation="Vertical">
                                                                <RadioButton
                                                                    Height="26"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    Command="{Binding SetStretchCommand}"
                                                                    CommandParameter="Uniform"
                                                                    Content="等比适应 (不变形)"
                                                                    FontSize="11"
                                                                    IsChecked="{Binding IsStretchUniform,
                                                                                        Mode=OneWay}"
                                                                    ToolTip="保持原始比例不变形，窗口空隙显示黑边" />
                                                                <RadioButton
                                                                    Height="26"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    Command="{Binding SetStretchCommand}"
                                                                    CommandParameter="UniformToFill"
                                                                    Content="等比裁剪 (填满不变形)"
                                                                    FontSize="11"
                                                                    IsChecked="{Binding IsStretchUniformToFill,
                                                                                        Mode=OneWay}"
                                                                    ToolTip="保持原始比例不变形，填满窗口并裁剪超出部分" />
                                                                <RadioButton
                                                                    Height="26"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    Command="{Binding SetStretchCommand}"
                                                                    CommandParameter="Fill"
                                                                    Content="拉伸铺满 (可能变形)"
                                                                    FontSize="11"
                                                                    IsChecked="{Binding IsStretchFill,
                                                                                        Mode=OneWay}"
                                                                    ToolTip="填满整个窗口，比例不一致时画面会被拉伸或压扁" />
                                                            </hc:ButtonGroup>

                                                            <Separator Margin="0,0,0,6" />

                                                            <!--  画面翻转控制  -->
                                                            <TextBlock
                                                                Margin="0,0,0,3"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Text="画面翻转:" />
                                                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                                                <CheckBox
                                                                    Content="水平镜像"
                                                                    FontSize="11"
                                                                    IsChecked="{Binding IsFlipHorizontal,
                                                                                        Mode=TwoWay}"
                                                                    ToolTip="左右水平镜像翻转" />
                                                                <CheckBox
                                                                    Content="垂直翻转"
                                                                    FontSize="11"
                                                                    IsChecked="{Binding IsFlipVertical,
                                                                                        Mode=TwoWay}"
                                                                    ToolTip="上下垂直翻转" />
                                                            </UniformGrid>

                                                            <Separator Margin="0,0,0,6" />

                                                            <!--  物理接口规格与分辨率设置  -->
                                                            <StackPanel Margin="0,0,0,4" Orientation="Vertical">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text="物理接口规格:" />
                                                                <TextBlock
                                                                    Margin="0,1,0,0"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                                    Text="{Binding UsbSpeedDescription}" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Margin="0,2,0,2"
                                                                FontSize="11"
                                                                Text="采集分辨率:"
                                                                ToolTip="摄像头硬件采集分辨率，决定源画面细节" />
                                                            <ComboBox
                                                                Margin="0,0,0,3"
                                                                ItemsSource="{Binding SupportedResolutions}"
                                                                SelectedItem="{Binding SelectedResolution,
                                                                                       Mode=TwoWay}"
                                                                Style="{StaticResource ComboBoxExtend}" />

                                                            <StackPanel Margin="0,1,0,4" Orientation="Horizontal">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text="传输带宽: " />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="DarkOrange"
                                                                    Text="{Binding EstimatedMbPerSec,
                                                                                   StringFormat={}{0:F1} MB/s}" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Margin="0,2,0,2"
                                                                FontSize="11"
                                                                Text="录制分辨率:"
                                                                ToolTip="写入视频文件的分辨率，低于采集分辨率时会自动缩放以节省空间" />
                                                            <ComboBox
                                                                Margin="0,0,0,4"
                                                                ItemsSource="{Binding SupportedRecordResolutions}"
                                                                SelectedItem="{Binding SelectedRecordResolution,
                                                                                       Mode=TwoWay}"
                                                                Style="{StaticResource ComboBoxExtend}" />

                                                            <!--  录制帧率  -->
                                                            <Grid Margin="0,2,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Text="录制帧率:"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                                    Text="{Binding RecordFps,
                                                                                   StringFormat={}{0} FPS}" />
                                                            </Grid>
                                                            <Slider
                                                                Margin="0,1,0,4"
                                                                IsSnapToTickEnabled="True"
                                                                Maximum="{Binding Fps}"
                                                                Minimum="1"
                                                                TickFrequency="1"
                                                                ToolTip="录制帧率，越低越省CPU和存储空间"
                                                                Value="{Binding RecordFps,
                                                                                Mode=TwoWay}" />

                                                            <StackPanel Margin="0,1,0,4" Orientation="Horizontal">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text="当前采集尺寸: " />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text="{Binding Width}" />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text=" × " />
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="Gray"
                                                                    Text="{Binding Height}" />
                                                            </StackPanel>

                                                            <Separator Margin="0,2,0,5" />

                                                            <!--  自定义水印  -->
                                                            <TextBlock
                                                                Margin="0,0,0,2"
                                                                FontSize="11"
                                                                Text="自定义水印:" />
                                                            <TextBox
                                                                Margin="0,0,0,2"
                                                                hc:InfoElement.Placeholder="输入水印文字(实时生效)"
                                                                infrastructure:InputBehavior.UpdateOnEnter="True"
                                                                Style="{StaticResource TextBoxExtend}"
                                                                Text="{Binding CustomOverlayText,
                                                                               UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!--  2. 录像相关 (录像开关、回放目录、压缩与存储保护)  -->
                                <Expander
                                    Margin="0,0,0,4"
                                    ExpandDirection="Down"
                                    Header="录像相关"
                                    IsExpanded="False">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel Margin="6">
                                            <!--  录像总开关  -->
                                            <TextBlock
                                                Margin="0,0,0,3"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="录像状态:" />
                                            <hc:ButtonGroup Margin="0,0,0,6">
                                                <RadioButton
                                                    Content="录像关"
                                                    FontSize="11"
                                                    IsChecked="{c:Binding !isSave}" />
                                                <RadioButton
                                                    Content="录像开"
                                                    FontSize="11"
                                                    IsChecked="{c:Binding isSave}" />
                                            </hc:ButtonGroup>

                                            <!--  快捷操作按钮  -->
                                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                                <Button
                                                    Margin="0,0,2,0"
                                                    Command="{Binding ViewPlayback}"
                                                    Content="查看回放"
                                                    FontSize="11"
                                                    Style="{StaticResource ButtonDefault.Small}" />
                                                <Button
                                                    Margin="2,0,0,0"
                                                    Command="{Binding OpenRecordingFolderCommand}"
                                                    Content="录像目录"
                                                    FontSize="11"
                                                    Style="{StaticResource ButtonDefault.Small}"
                                                    ToolTip="打开保存录像的文件夹" />
                                            </UniformGrid>

                                            <Separator Margin="0,0,0,6" />

                                            <!--  压缩程度与保存间隔  -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="压缩程度 (CRF)"
                                                    ToolTip="数值越大压缩率越高，文件体积越小 (0-51)"
                                                    VerticalAlignment="Center" />
                                                <hc:NumericUpDown
                                                    Name="NumericUpDownCustomVerify"
                                                    Grid.Column="1"
                                                    Width="72"
                                                    Height="24"
                                                    infrastructure:InputBehavior.UpdateOnEnter="True"
                                                    Maximum="51"
                                                    Minimum="0"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="当前值越大，保存文件越小 (推荐 23-28)"
                                                    Value="{Binding Quality}" />
                                            </Grid>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="分段间隔 (分钟)"
                                                    ToolTip="录像单文件切片保存间隔时间"
                                                    VerticalAlignment="Center" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Width="72"
                                                    Height="24"
                                                    infrastructure:InputBehavior.UpdateOnEnter="True"
                                                    Maximum="99"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="分钟"
                                                    Value="{Binding SaveInterval}" />
                                            </Grid>

                                            <Separator Margin="0,0,0,6" />

                                            <!--  空间防护策略  -->
                                            <TextBlock
                                                Margin="0,0,0,3"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="空间保护阈值:" />
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="0,0,3,0"
                                                    FontSize="11"
                                                    Text="余量 &lt;"
                                                    VerticalAlignment="Center" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Margin="0,0,3,0"
                                                    Height="24"
                                                    infrastructure:InputBehavior.EnterCommand="{Binding ConfirmDiskThresholdCommand}"
                                                    infrastructure:InputBehavior.UpdateOnEnter="True"
                                                    Maximum="1024000"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    Value="{Binding DiskSpaceThresholdInput}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="0,0,4,0"
                                                    FontSize="11"
                                                    Text="MB"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    Grid.Column="3"
                                                    Height="24"
                                                    Padding="6,0"
                                                    Command="{Binding ConfirmDiskThresholdCommand}"
                                                    Content="应用"
                                                    FontSize="11"
                                                    Style="{StaticResource ButtonPrimary.Small}" />
                                            </Grid>
                                            <TextBlock
                                                Margin="0,0,0,5"
                                                FontSize="10"
                                                Foreground="{Binding DiskSpaceThresholdStatusColor}"
                                                Text="{Binding DiskSpaceThresholdStatusText}"
                                                TextWrapping="Wrap" />

                                            <hc:ButtonGroup Margin="0,0,0,2" Orientation="Vertical">
                                                <RadioButton
                                                    Height="24"
                                                    Content="空间不足覆盖旧文件"
                                                    FontSize="11"
                                                    IsChecked="{c:Binding OverwriteOldFiles}" />
                                                <RadioButton
                                                    Height="24"
                                                    Content="空间不足停止录像"
                                                    FontSize="11"
                                                    IsChecked="{c:Binding !OverwriteOldFiles}" />
                                            </hc:ButtonGroup>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!--  3. 显示增强 (置顶、透明度、夜间、亮度和对比度、预览优化)  -->
                                <Expander
                                    Margin="0,0,0,4"
                                    ExpandDirection="Down"
                                    Header="显示增强"
                                    IsExpanded="False">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel Margin="6">
                                            <!--  置顶与夜间模式  -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="窗口始终置顶"
                                                    VerticalAlignment="Center" />
                                                <ToggleButton
                                                    x:Name="topMostButton"
                                                    Grid.Column="1"
                                                    Click="ToggleButton_Click"
                                                    IsChecked="True"
                                                    ToolTip="窗口置顶">
                                                    <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                                        <materialDesign:PackIcon.RenderTransform>
                                                            <RotateTransform Angle="45" />
                                                        </materialDesign:PackIcon.RenderTransform>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:ToggleButtonAssist.OnContent>
                                                        <materialDesign:PackIcon Kind="Pin" />
                                                    </materialDesign:ToggleButtonAssist.OnContent>
                                                    <ToggleButton.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.MergedDictionaries>
                                                                <materialDesign:BundledTheme
                                                                    BaseTheme="Light"
                                                                    PrimaryColor="BlueGrey"
                                                                    SecondaryColor="Lime" />
                                                                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                                            </ResourceDictionary.MergedDictionaries>
                                                        </ResourceDictionary>
                                                    </ToggleButton.Resources>
                                                </ToggleButton>
                                            </Grid>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="夜间暗光增强"
                                                    ToolTip="自适应直方图均衡化(CLAHE)，大幅提升夜间或逆光暗部清晰度"
                                                    VerticalAlignment="Center" />
                                                <ToggleButton
                                                    Grid.Column="1"
                                                    IsChecked="{Binding IsGrayHomogenization}"
                                                    ToolTip="是否开启自适应直方图均衡化">
                                                    <materialDesign:PackIcon Kind="WhiteBalanceSunny" RenderTransformOrigin=".5,.5">
                                                        <materialDesign:PackIcon.RenderTransform>
                                                            <RotateTransform Angle="45" />
                                                        </materialDesign:PackIcon.RenderTransform>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:ToggleButtonAssist.OnContent>
                                                        <materialDesign:PackIcon Kind="WeatherNight" />
                                                    </materialDesign:ToggleButtonAssist.OnContent>
                                                    <ToggleButton.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.MergedDictionaries>
                                                                <materialDesign:BundledTheme
                                                                    BaseTheme="Light"
                                                                    PrimaryColor="BlueGrey"
                                                                    SecondaryColor="Lime" />
                                                                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                                            </ResourceDictionary.MergedDictionaries>
                                                        </ResourceDictionary>
                                                    </ToggleButton.Resources>
                                                </ToggleButton>
                                            </Grid>

                                            <Separator Margin="0,0,0,5" />

                                            <!--  透明度调节  -->
                                            <Grid Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="窗口透明度"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Foreground="Gray"
                                                    Text="{Binding Opacity,
                                                                   StringFormat={}{0:P0}}" />
                                            </Grid>
                                            <Slider
                                                x:Name="OpacitySlider"
                                                Margin="0,0,0,4"
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="1.0"
                                                Minimum="0.1"
                                                TickFrequency="0.05"
                                                ToolTip="窗口几乎透明--窗口不透明"
                                                Value="{Binding Opacity}" />

                                            <Separator Margin="0,0,0,5" />

                                            <!--  预览帧率与分辨率优化  -->
                                            <Grid Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="预览帧率上限"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Foreground="Gray"
                                                    Text="{Binding PreviewFps,
                                                                   StringFormat={}{0} FPS}" />
                                            </Grid>
                                            <Slider
                                                Margin="0,0,0,4"
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="{Binding MaxFps}"
                                                Minimum="1"
                                                TickFrequency="1"
                                                ToolTip="预览帧率，越低越省CPU/GPU"
                                                Value="{Binding PreviewFps}" />

                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="11"
                                                Text="预览显示分辨率:"
                                                ToolTip="仅影响UI预览画面的显示分辨率，不影响录像质量。降低可减少CPU占用。" />
                                            <ComboBox
                                                Margin="0,0,0,5"
                                                ItemsSource="{Binding PreviewWidthOptions}"
                                                SelectedItem="{Binding SelectedPreviewWidth,
                                                                       Mode=TwoWay}"
                                                Style="{StaticResource ComboBoxExtend}"
                                                ToolTip="UI预览画面的显示分辨率，不影响录像分辨率" />

                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontSize="11"
                                                Text="穿透模式快捷键:"
                                                ToolTip="点击输入框后按下新的快捷键组合可快速修改（默认: Ctrl+F1）" />
                                            <hk:HotKeyBox
                                                Width="Auto"
                                                Height="24"
                                                Margin="0,0,0,5"
                                                HorizontalAlignment="Stretch"
                                                ActualBackground="#F5F5F5"
                                                CornerRadius="4"
                                                CurrentKeyA="0x0002"
                                                CurrentKeyB="F1"
                                                FixedBorderBrush="#D0D0D0"
                                                FixedBorderThickness="1"
                                                Handler="GlobalDo"
                                                HoverBorderBrush="#326cf3"
                                                HoverTextColor="#326cf3"
                                                TextColor="#333333"
                                                ToolTip="点击后按下新快捷键即可修改（当前: Ctrl+F1）" />

                                            <Separator Margin="0,0,0,5" />

                                            <!--  画面亮度与对比度  -->
                                            <Grid Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="亮度调节"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Foreground="Gray"
                                                    Text="{Binding Luminance,
                                                                   StringFormat={}{0:F0}}" />
                                            </Grid>
                                            <Slider
                                                Margin="0,0,0,3"
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="100.0"
                                                Minimum="-100.0"
                                                TickFrequency="1"
                                                ToolTip="亮度暗--亮"
                                                Value="{Binding Luminance}" />

                                            <Grid Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="对比度调节"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Foreground="Gray"
                                                    Text="{Binding Contrast,
                                                                   StringFormat={}{0:F1}}" />
                                            </Grid>
                                            <Slider
                                                Margin="0,0,0,4"
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="4"
                                                Minimum="0"
                                                TickFrequency="0.1"
                                                ToolTip="对比度低--高"
                                                Value="{Binding Contrast}" />

                                            <Button
                                                Height="22"
                                                Margin="0,0,0,6"
                                                Padding="6,0"
                                                HorizontalAlignment="Right"
                                                Command="{Binding ResetImageSettings}"
                                                Content="重置亮度和对比度"
                                                FontSize="10"
                                                Style="{StaticResource ButtonDashedWarning.Small}"
                                                ToolTip="重置亮度为0、对比度为1.0" />

                                            <Separator Margin="0,0,0,5" />

                                            <!--  水印大小调节  -->
                                            <Grid Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="水印大小调节"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Foreground="Gray"
                                                    Text="{Binding OverlayTextSize,
                                                                   StringFormat={}{0:F1}x}" />
                                            </Grid>
                                            <Slider
                                                Margin="0,0,0,2"
                                                hc:TipElement.Placement="Top"
                                                hc:TipElement.Visibility="Visible"
                                                IsSnapToTickEnabled="True"
                                                Maximum="2.0"
                                                Minimum="0.3"
                                                TickFrequency="0.1"
                                                ToolTip="全局水印和时间戳大小比例"
                                                Value="{Binding OverlayTextSize,
                                                                Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!--  4. 系统状态 (磁盘空间监控、编码硬件加速状态)  -->
                                <Expander
                                    Margin="0,0,0,2"
                                    ExpandDirection="Down"
                                    Header="系统状态"
                                    IsExpanded="True">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel Margin="6">
                                            <!--  磁盘空间与预估时长  -->
                                            <TextBlock
                                                Margin="0,0,0,3"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="空间预计录制:" />
                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="6,4"
                                                Background="#FAFAFA"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{Binding DiskSpaceWarningColor}"
                                                    LineHeight="16"
                                                    Text="{Binding DiskSpaceWarningText}"
                                                    TextWrapping="Wrap" />
                                            </Border>

                                            <Separator Margin="0,0,0,5" />

                                            <!--  编码硬件加速状态指示与强制CPU选项  -->
                                            <TextBlock
                                                Margin="0,0,0,3"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Text="编码加速:" />
                                            <CheckBox
                                                Margin="0,0,0,4"
                                                Content="仅使用 CPU 编码"
                                                FontSize="11"
                                                IsChecked="{Binding ForceCpuEncoding}"
                                                ToolTip="默认优先使用 GPU 硬件加速(NVENC/QSV/AMF)；勾选后强制使用 CPU 软编(libx264)" />

                                            <!--  GPU 硬件加速徽章  -->
                                            <Border
                                                Margin="0,1,0,2"
                                                Padding="5,4"
                                                Background="#E8F5E9"
                                                BorderBrush="#81C784"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                ToolTip="{Binding SelectedConfigCamera.ActiveCodec,
                                                                  StringFormat='当前活动编码器: {0}'}"
                                                Visibility="{c:Binding IsGpuEncodingActive,
                                                                       FalseToVisibility=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#4CAF50" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#2E7D32"
                                                        Text="GPU 硬件加速" />
                                                </StackPanel>
                                            </Border>

                                            <!--  CPU 软编徽章  -->
                                            <Border
                                                Margin="0,1,0,2"
                                                Padding="5,4"
                                                Background="#FFFDE7"
                                                BorderBrush="#FFF176"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                ToolTip="{Binding SelectedConfigCamera.ActiveCodec,
                                                                  StringFormat='当前活动编码器: {0}'}"
                                                Visibility="{c:Binding IsCpuEncodingActive,
                                                                       FalseToVisibility=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#FBC02D" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#F57F17"
                                                        Text="CPU 软件编码" />
                                                </StackPanel>
                                            </Border>

                                            <!--  未录制徽章  -->
                                            <Border
                                                Margin="0,1,0,2"
                                                Padding="5,4"
                                                Background="#ECEFF1"
                                                BorderBrush="#B0BEC5"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{c:Binding IsEncodingInactive,
                                                                       FalseToVisibility=Collapsed}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="#78909C" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="#37474F"
                                                        Text="未开启录制" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </hc:TransitioningContentControl>

        <!--  窗口 8 向自由变形与缩放边缘控制层 (全向自由拖拽，杜绝比例锁定)  -->
        <Grid
            x:Name="WindowResizeBorderGrid"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Panel.ZIndex="1000"
            IsHitTestVisible="{c:Binding 'WindowState != System.Windows.WindowState.Maximized'}">
            <!-- 四边 -->
            <Rectangle
                Height="6"
                Margin="12,0"
                VerticalAlignment="Top"
                Cursor="SizeNS"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="Top" />
            <Rectangle
                Height="6"
                Margin="12,0"
                VerticalAlignment="Bottom"
                Cursor="SizeNS"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="Bottom" />
            <Rectangle
                Width="6"
                Margin="0,12"
                HorizontalAlignment="Left"
                Cursor="SizeWE"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="Left" />
            <Rectangle
                Width="6"
                Margin="0,12"
                HorizontalAlignment="Right"
                Cursor="SizeWE"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="Right" />

            <!-- 四角 -->
            <Rectangle
                Width="12"
                Height="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Cursor="SizeNWSE"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="TopLeft" />
            <Rectangle
                Width="12"
                Height="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Cursor="SizeNESW"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="TopRight" />
            <Rectangle
                Width="12"
                Height="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Cursor="SizeNESW"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="BottomLeft" />
            <Rectangle
                Width="12"
                Height="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                Fill="Transparent"
                MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Tag="BottomRight" />
        </Grid>
    </Grid>
</Window>
