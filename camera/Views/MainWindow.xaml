<Window
    x:Class="camera.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:hk="clr-namespace:FastHotKeyForWPF;assembly=FastHotKeyForWPF"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:camera"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="900"
    Height="480"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStyle="None">
    <!--
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None">
    -->

    <!-- <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="0"
                        CornerRadius="5"
                        GlassFrameThickness="-1"
                        NonClientFrameEdges="None"
                        UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>-->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <local:MatToImageSourceConverter x:Key="MatToImageSourceConverter" />
        <Storyboard x:Key="FlashStoryboard" RepeatBehavior="Forever">
            <!--  瞬间切换到不透明  -->
            <DoubleAnimation
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0" />
            <!--  等待一段时间  -->
            <DoubleAnimation
                BeginTime="0:0:0.5"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0" />
            <!--  切回透明  -->
            <DoubleAnimation
                BeginTime="0:0:1.0"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0" />
            <!--  等待一段时间  -->
            <DoubleAnimation
                BeginTime="0:0:1.5"
                Storyboard.TargetName="RecordEllipse"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0" />
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            MouseEnter="MainContentGrid_MouseEnter"
            MouseLeave="MainContentGrid_MouseLeave">
            <!-- <Image Source="{Binding Cam.Frame, Converter={StaticResource MatToImageSourceConverter}}" /> -->

            <Border
                x:Name="MainBorder"
                Margin="10,2,2,10"
                BorderThickness="1"
                Effect="{StaticResource EffectShadow3}"
                Opacity="{Binding Opacity}">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="5">
                    <ItemsControl ItemsSource="{Binding Cameras}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{c:Binding 'Math.Ceiling(Math.Sqrt(Cameras.Count))'}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <hc:ImageBlock Margin="5" Source="{Binding Frame, Converter={StaticResource MatToImageSourceConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Border>

            <TextBlock
                x:Name="Instructions"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontSize="10"
                Foreground="White"
                Visibility="Hidden">
                穿透模式
            </TextBlock>

            <!--<TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="8"
                Foreground="Red"
                Visibility="{Binding isSave, Converter={StaticResource Boolean2VisibilityConverter}}">
                录像中
            </TextBlock>-->
            <Ellipse
                x:Name="RecordEllipse"
                Width="8"
                Height="8"
                Margin="20,20,12,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="Red"
                ToolTip="录制中"
                Visibility="{Binding isSave, Converter={StaticResource Boolean2VisibilityConverter}}">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Window.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FlashStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!--<materialDesign:PackIcon
    Grid.Column="0"
    Margin="10"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Kind="GamepadCircleRight">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Clicked">
            <i:InvokeCommandAction Command="{Binding ShowConsole}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</materialDesign:PackIcon>-->
            <!--<Button
    Width="30"
    Margin="20"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    hc:IconElement.Geometry="{StaticResource LeftGeometry}"
    Command="{Binding ShowConsole}"
    IsEnabled="True"
    Style="{StaticResource ButtonDashedWarning}" />-->

            <ToggleButton
                x:Name="ConsoleToggleButton"
                Width="30"
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                hc:IconSwitchElement.Geometry="{StaticResource RightGeometry}"
                hc:IconSwitchElement.GeometrySelected="{StaticResource LeftGeometry}"
                Command="{Binding ShowConsole}"
                Style="{StaticResource ToggleButtonIcon}"
                Visibility="Collapsed" />

            <ResizeGrip
                x:Name="WindowResizeGrip"
                Margin="10,2,2,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                Opacity="0" />

            <!--  自定义标题栏  -->
            <Grid
                x:Name="TitleBar"
                Grid.Row="0"
                Height="30"
                Margin="10,0,0,10"
                VerticalAlignment="Top"
                Background="#90000000"
                MouseEnter="TitleBar_MouseEnter"
                MouseLeave="TitleBar_MouseLeave"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="季华恒一离子注入机监控" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <!--<Button
              Width="30"
              Height="30"
              Click="MinimizeButton_Click"
              Content="—" />
          <Button
              Width="30"
              Height="30"
              Click="MaximizeRestoreButton_Click"
              Content="□" />
          <Button
              Width="30"
              Height="30"
              Click="CloseButton_Click"
              Content="×" />-->

                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMinGeometry}"
                        hc:IconElement.Height="16"
                        hc:IconElement.Width="16"
                        Click="MinimizeButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedWarning.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource WindowMaxGeometry}"
                        Click="MaximizeRestoreButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedSuccess.Small}" />
                    <Button
                        Width="25"
                        Margin="5,0,5,0"
                        hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                        Click="CloseButton_Click"
                        IsEnabled="True"
                        Style="{StaticResource ButtonDashedDanger.Small}" />
                </StackPanel>
            </Grid>

        </Grid>


        <!--<WrapPanel Grid.Row="1">
            <TextBlock>宽:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Width}" />
            <TextBlock>高:</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Height}" />
            <TextBlock>帧率</TextBlock>
            <TextBox Width="100" Text="{Binding Cam.Fps}" />
            <Button Command="{Binding Set}">应用</Button>
            <TextBlock VerticalAlignment="Center">是否保存:</TextBlock>
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding isSave}" />
        </WrapPanel>-->

        <hc:TransitioningContentControl
            x:Name="MyTransitioningContentControl"
            Grid.RowSpan="2"
            Grid.Column="1"
            TransitionMode="Left2RightWithFade"
            Visibility="{c:Binding ConsoleStatus,
                                   FalseToVisibility=Hidden}">
            <Border Margin="10" Effect="{StaticResource EffectShadow3}">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="5">

                    <Grid Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Expander
                                    Width="125"
                                    Margin="2"
                                    ExpandDirection="Down"
                                    Header="录像相关">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel>
                                            <hc:ButtonGroup Margin="5">
                                                <RadioButton Content="录像关" IsChecked="{c:Binding !isSave}" />
                                                <RadioButton Content="录像开" IsChecked="{c:Binding isSave}" />
                                            </hc:ButtonGroup>
                                            <UniformGrid Columns="2">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="Black">
                                                    压缩程度
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Name="NumericUpDownCustomVerify"
                                                    Margin="5"
                                                    Maximum="51"
                                                    Minimum="0"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="当前值越大,保存文件越小"
                                                    Value="{Binding Quality}" />

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    保存间隔
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Margin="5"
                                                    Maximum="99"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    ToolTip="分钟"
                                                    Value="{Binding SaveInterval}" />
                                            </UniformGrid>
                                            <Button
                                                Margin="5"
                                                Command="{Binding ViewPlayback}"
                                                Content="查看回放" />
                                            <!--<hc:Divider HorizontalContentAlignment="Left" Content="空间策略" />-->
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                空间策略
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" ToolTip="当前磁盘空间少于此MB数时">
                                                <TextBlock
                                                    Margin="2,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    少于
                                                </TextBlock>

                                                <hc:NumericUpDown
                                                    Width="78"
                                                    Margin="2"
                                                    Maximum="1024000"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownPlus}"
                                                    Value="{Binding DiskSpaceThreshold}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="Black">
                                                    M
                                                </TextBlock>
                                            </StackPanel>
                                            <Separator />
                                            <hc:ButtonGroup Margin="4" Orientation="Vertical">
                                                <RadioButton Content="覆盖旧文件" IsChecked="{c:Binding OverwriteOldFiles}" />
                                                <RadioButton Content="停止录像" IsChecked="{c:Binding !OverwriteOldFiles}" />
                                            </hc:ButtonGroup>

                                            <!--<TextBlock Foreground="Black">保存质量:</TextBlock>-->


                                        </StackPanel>

                                    </Border>
                                </Expander>

                                <Expander
                                    Width="125"
                                    Margin="2"
                                    ExpandDirection="Down"
                                    Header="其他设置"
                                    IsExpanded="True">
                                    <Border
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,4,4,0">
                                        <StackPanel>
                                            <UniformGrid Columns="2">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">是否置顶</TextBlock>
                                                <ToggleButton
                                                    x:Name="topMostButton"
                                                    HorizontalAlignment="Center"
                                                    Click="ToggleButton_Click"
                                                    IsChecked="True"
                                                    ToolTip="窗口置顶">
                                                    <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                                                        <materialDesign:PackIcon.RenderTransform>
                                                            <RotateTransform Angle="45" />
                                                        </materialDesign:PackIcon.RenderTransform>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:ToggleButtonAssist.OnContent>
                                                        <materialDesign:PackIcon Kind="Pin" />
                                                    </materialDesign:ToggleButtonAssist.OnContent>
                                                    <ToggleButton.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.MergedDictionaries>
                                                                <materialDesign:BundledTheme
                                                                    BaseTheme="Light"
                                                                    PrimaryColor="BlueGrey"
                                                                    SecondaryColor="Lime" />
                                                                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                                            </ResourceDictionary.MergedDictionaries>
                                                        </ResourceDictionary>
                                                    </ToggleButton.Resources>
                                                </ToggleButton>
                                            </UniformGrid>
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                透明度调节
                                            </TextBlock>
                                            <Slider
                                                x:Name="OpacitySlider"
                                                IsSnapToTickEnabled="True"
                                                Maximum="1.0"
                                                Minimum="0.1"
                                                TickFrequency="0.1"
                                                ToolTip="窗口几乎透明--窗口不透明"
                                                Value="{Binding Opacity}" />
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                穿透模式快捷键
                                            </TextBlock>
                                            <hk:HotKeyBox
                                                Width="120"
                                                Height="14"
                                                Margin="0,4,0,4"
                                                ActualBackground="LightGray"
                                                CurrentKeyA="0x0002"
                                                CurrentKeyB="F1"
                                                FontSize="8"
                                                Handler="GlobalDo"
                                                HoverBorderBrush="#326cf3"
                                                HoverTextColor="#326cf3"
                                                ToolTip="穿透模式快捷键" />
                                            <Separator />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                亮度调节
                                            </TextBlock>
                                            <Slider
                                                IsSnapToTickEnabled="True"
                                                Maximum="100.0"
                                                Minimum="-100.0"
                                                TickFrequency="0.1"
                                                ToolTip="亮度暗--亮"
                                                Value="{Binding Luminance}" />
                                            <TextBlock
                                                Margin="4"
                                                HorizontalAlignment="Center"
                                                FontSize="11">
                                                对比度调节
                                            </TextBlock>
                                            <Slider
                                                IsSnapToTickEnabled="True"
                                                Maximum="1"
                                                Minimum="-1"
                                                TickFrequency="0.1"
                                                ToolTip="对比度低--高"
                                                Value="{Binding Contrast}" />
                                        </StackPanel>

                                    </Border>
                                </Expander>
                            </StackPanel>








                        </ScrollViewer>

                    </Grid>

                    <!--<TabControl TabStripPlacement="Left">
                        <TabControl.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <materialDesign:BundledTheme
                                        BaseTheme="Light"
                                        PrimaryColor="DeepPurple"
                                        SecondaryColor="Lime" />
                                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </TabControl.Resources>
                        <TabItem Header="TAB 1">
                            <TextBlock Margin="8" Text="Left placement" />
                        </TabItem>
                        <TabItem Header="TAB 2">
                            <TextBlock Margin="8" Text="Left placement" />
                        </TabItem>
                    </TabControl>-->
                </Border>
            </Border>
        </hc:TransitioningContentControl>
    </Grid>
</Window>
