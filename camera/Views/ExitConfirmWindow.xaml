<Window
    x:Class="camera.Views.ExitConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="退出确认"
    Width="380"
    Height="220"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">
    
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.15" ShadowDepth="1"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M13,16H11V14H13V16M13,12H11V8H13V12Z" 
                      Fill="#FF9800" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="退出确认" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="#333333"/>
            </StackPanel>
            
            <!-- 提示消息 -->
            <TextBlock Grid.Row="1" Text="您点击了关闭按钮，请选择程序关闭行为：" FontSize="12" Margin="0,15,0,0" Foreground="#555555" TextWrapping="Wrap" VerticalAlignment="Top"/>
            
            <!-- 复选框（记住选择） -->
            <CheckBox x:Name="RememberChoiceCheckBox" Grid.Row="2" Content="记住我的选择，下次不再提示" FontSize="11" Margin="0,10,0,15" VerticalAlignment="Center" Foreground="#777777"/>
            
            <!-- 操作按钮 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMinimize" Content="退至后台" Style="{StaticResource ButtonPrimary}" Height="28" Width="80" Margin="0,0,10,0" Click="BtnMinimize_Click"/>
                <Button x:Name="BtnExit" Content="彻底退出" Style="{StaticResource ButtonDanger}" Height="28" Width="80" Margin="0,0,10,0" Click="BtnExit_Click"/>
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource ButtonDefault}" Height="28" Width="65" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
