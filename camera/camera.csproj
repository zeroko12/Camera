<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net6.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<ApplicationIcon>jh.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="jh.ico" />
	</ItemGroup>
	<ItemGroup>
		<!-- 编译时将 models 文件夹下的文件复制到输出根目录 -->
		<None Include="models\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CalcBinding6" Version="1.1.0" />
		<PackageReference Include="FastHotKeyForWPF" Version="2.1.0" />
		<PackageReference Include="HandyControl" Version="3.5.1" />
		<PackageReference Include="MaterialDesignThemes" Version="5.1.1-ci753" />
		<PackageReference Include="Obfuscar" Version="3.0.0-beta.6">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
		<PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.10.0.20240616" />
		<PackageReference Include="Prism.DryIoc" Version="8.1.97" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
	  <PropertyGroup>
	    <ObfuscarConfig>$([System.IO.File]::ReadAllText('$(ProjectDir)Obfuscar.xml').Replace('{TargetDir}', '$(TargetDir)'))</ObfuscarConfig>
	  </PropertyGroup>
	  <WriteLinesToFile File="$(TargetDir)Obfuscar.xml" Lines="$(ObfuscarConfig)" Overwrite="true" />
	  <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(TargetDir)Obfuscar.xml&quot;" />
	</Target>
</Project>